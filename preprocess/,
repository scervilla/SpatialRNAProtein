
path_obj <- "~/projects/ProstateMO//Robj/"

samples <- readLines("projects/ProstateMO/utils/prost_samples.txt")

mat <- lapply(samples, function(sample) {
  print(sample)
  
  object <- readRDS(paste0(path_obj, sample, ".rds"))
  object <- subset(object, nCount_Xenium > 3)
  mat <- object@assays$Protein$counts
  colnames(mat) <- paste0(sample, "_", colnames(mat))
  mat
})
prot <- do.call(cbind, mat)
saveRDS(prot, "projects/LungTMA/benchmark/Results/prot_exp/prot_PROST.rds")

